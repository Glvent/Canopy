{
  "files.exclude": {
    "LICENSE": true,
    "licenses": true,
    "docs": false,
    "config.nims": true,
    "tools/reference/Cargo.toml": true,
    "tools/reference/README.md": true,
    "src/canopy/THIRD_PARTY_NOTICES.txt": true,
    "tools/colors/reference": true,
    "tools/terminal/reference": true,
    "tools/**/*README*": true,
    "tools/**/*LICENSE*": true,
    "tools/**/*NOTICE*": true,
    "tools/**/*validation*": true,
    "**/nimcache": true
  },
  "files.watcherExclude": {
    "**/target": true,
    "**/nimcache": true
  }
}
